{
  "window": {
    "width": 850,
    "height": 900
  },
  "theme": "dark",
  "integrations": {
    "codexAgent": true,
    "crossReview": true
  },
  "title": "タスクと完了条件",
  "scenario": "basic",
  "steps": [
    {
      "do": "screenshot",
      "name": "list",
      "target": [
        ".session-body > h3.sub:has(+ ul.task-list)",
        ".session-body > ul.task-list + .ended-toggle + .ended-toggle"
      ],
      "parts": {
        "task.heading": ".session-body > h3.sub:has(+ ul.task-list)",
        "task.state": ".session-body > ul.task-list > .task-item:nth-child(1) .badge",
        "task.title": ".session-body > ul.task-list > .task-item:nth-child(1) .task-title",
        "task.count": ".session-body > ul.task-list > .task-item:nth-child(1) .task-head > .meta",
        "task.close": ".session-body > ul.task-list > .task-item:nth-child(1) .close-task",
        "task.criteria": ".session-body > ul.task-list > .task-item:nth-child(1) .criteria-list",
        "task.todo-toggle": ".session-body > ul.task-list + .ended-toggle",
        "task.done-toggle": ".session-body > ul.task-list + .ended-toggle + .ended-toggle"
      }
    },
    {
      "do": "click",
      "selector": ".session-body > ul.task-list > .task-item:nth-child(1) .close-task"
    },
    {
      "do": "wait",
      "selector": ".session-body > ul.task-list > .task-item:nth-child(1) [data-cancel-close-task]"
    },
    {
      "do": "screenshot",
      "name": "closing",
      "target": ".session-body > ul.task-list > .task-item:nth-child(1) .task-head",
      "parts": {
        "closing.cancel": ".session-body > ul.task-list > .task-item:nth-child(1) [data-cancel-close-task]",
        "closing.note": ".session-body > ul.task-list > .task-item:nth-child(1) .task-head > .meta:last-child"
      }
    }
  ]
}
