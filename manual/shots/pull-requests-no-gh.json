{
  "window": {
    "width": 850,
    "height": 900
  },
  "theme": "dark",
  "integrations": {
    "codexAgent": true,
    "crossReview": true
  },
  "title": "GitHub CLI が使えないとき",
  "scenario": "no-gh",
  "storage": {
    "agent-cockpit.display": {
      "mode": "product"
    }
  },
  "steps": [
    {
      "do": "screenshot",
      "name": "error",
      "target": ".pr-repo-group",
      "parts": {
        "error.repo": ".pr-repo-group .pr-repo-title",
        "error.fetched": ".pr-repo-group .prs-head > .meta",
        "error.box": ".pr-repo-group .error-box",
        "error.unregister": ".pr-repo-group [data-repo-unregister-action=\"open\"]"
      }
    }
  ]
}
