{
  "window": {
    "width": 850,
    "height": 900
  },
  "theme": "dark",
  "integrations": {
    "codexAgent": true,
    "crossReview": true
  },
  "title": "レビュー収束後マージの予約",
  "scenario": "basic",
  "steps": [
    {
      "do": "click",
      "selector": "#root > section.section:nth-child(1) .pr-repo-content > .stack:nth-child(1) .pr-actions input[data-reservation-toggle]"
    },
    {
      "do": "wait",
      "selector": "#root > section.section:nth-child(1) .pr.reserved"
    },
    {
      "do": "screenshot",
      "name": "reserved",
      "target": "#root > section.section:nth-child(1) .pr-repo-group",
      "parts": {
        "reserved.card": "#root > section.section:nth-child(1) .pr-repo-group .pr-repo-content > .stack:nth-child(1) .pr.reserved",
        "reserved.badge": "#root > section.section:nth-child(1) .pr-repo-group .pr-repo-content > .stack:nth-child(1) .badges .badge.accent",
        "reserved.merge-button": "#root > section.section:nth-child(1) .pr-repo-group .pr-repo-content > .stack:nth-child(1) .pr-actions .merge-btn",
        "reserved.toggle": "#root > section.section:nth-child(1) .pr-repo-group .pr-repo-content > .stack:nth-child(1) .pr-actions input[data-reservation-toggle]"
      }
    },
    {
      "do": "click",
      "selector": "#root > section.section:nth-child(1) .pr-repo-content > .stack:nth-child(1) .pr-actions input[data-reservation-toggle]"
    },
    {
      "do": "wait",
      "selector": "#root > section.section:nth-child(1) .pr.reserved",
      "gone": true
    },
    {
      "do": "screenshot",
      "name": "cancelled",
      "target": "#root > section.section:nth-child(1) .pr-repo-group",
      "parts": {
        "cancelled.notice": "#root > section.section:nth-child(1) .pr-repo-group .pr-repo-content > .merge-result",
        "cancelled.merge-button": "#root > section.section:nth-child(1) .pr-repo-group .pr-repo-content > .merge-result + .stack .pr-actions .merge-btn",
        "cancelled.toggle": "#root > section.section:nth-child(1) .pr-repo-group .pr-repo-content > .merge-result + .stack .pr-actions input[data-reservation-toggle]"
      }
    }
  ]
}
