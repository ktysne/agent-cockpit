{
  "window": {
    "width": 850,
    "height": 900
  },
  "theme": "dark",
  "integrations": {
    "codexAgent": true,
    "crossReview": true
  },
  "title": "レビュー収束後マージの予約",
  "scenario": "basic",
  "steps": [
    {
      "do": "click",
      "selector": "#root > section.section:nth-child(1) .merge-btn"
    },
    {
      "do": "wait",
      "selector": "#root > section.section:nth-child(1) .merge-confirm"
    },
    {
      "do": "click",
      "selector": "#root > section.section:nth-child(1) .merge-confirm input[data-merge-after-review]"
    },
    {
      "do": "screenshot",
      "name": "confirm",
      "target": "#root > section.section:nth-child(1) .pr-repo-group",
      "parts": {
        "reserve.heading": "#root > section.section:nth-child(1) .merge-confirm > div:first-child",
        "reserve.review": "#root > section.section:nth-child(1) .merge-confirm label.opt:has([data-merge-after-review])",
        "reserve.head": "#root > section.section:nth-child(1) .merge-confirm .effects li:last-child",
        "reserve.go": "#root > section.section:nth-child(1) .merge-confirm .merge-go"
      }
    },
    {
      "do": "click",
      "selector": "#root > section.section:nth-child(1) [data-merge-go]"
    },
    {
      "do": "wait",
      "selector": "#root > section.section:nth-child(1) .pr.reserved"
    },
    {
      "do": "screenshot",
      "name": "reserved",
      "target": "#root > section.section:nth-child(1) .pr-repo-group",
      "parts": {
        "reserved.card": "#root > section.section:nth-child(1) .pr-repo-group .pr-repo-content > .stack:nth-child(1) .pr.reserved",
        "reserved.badge": "#root > section.section:nth-child(1) .pr-repo-group .pr-repo-content > .stack:nth-child(1) .badges .badge.accent",
        "reserved.cancel": "#root > section.section:nth-child(1) .pr-repo-group .pr-repo-content > .stack:nth-child(1) [data-cancel-reservation]"
      }
    },
    {
      "do": "click",
      "selector": "#root > section.section:nth-child(1) [data-cancel-reservation]"
    },
    {
      "do": "wait",
      "selector": "#root > section.section:nth-child(1) .pr.reserved",
      "gone": true
    },
    {
      "do": "screenshot",
      "name": "cancelled",
      "target": "#root > section.section:nth-child(1) .pr-repo-group",
      "parts": {
        "cancelled.notice": "#root > section.section:nth-child(1) .pr-repo-group .pr-repo-content > .merge-result",
        "cancelled.merge-button": "#root > section.section:nth-child(1) .pr-repo-group .pr-repo-content > .stack:nth-child(2) .merge-btn"
      }
    }
  ]
}
