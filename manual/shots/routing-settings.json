{
  "title": "経路の設定(2 つの連携がある)",
  "scenario": "basic",
  "window": {
    "width": 850,
    "height": 900
  },
  "theme": "dark",
  "integrations": {
    "codexAgent": true,
    "crossReview": true
  },
  "storage": {
    "agent-cockpit.display": {
      "mode": "product"
    }
  },
  "steps": [
    {
      "do": "screenshot",
      "name": "both",
      "target": "#routing",
      "parts": {
        "routing.agents": [
          "#routing .rgroup > .rrow:nth-child(1) .rlabel",
          "#routing .rgroup > .rrow:nth-child(1) .seg"
        ],
        "routing.review": [
          "#routing .rgroup > .rrow:nth-child(2) .rlabel",
          "#routing .rgroup > .rrow:nth-child(2) .seg"
        ],
        "routing.selected": "#routing .rgroup > .rrow:nth-child(1) .seg [aria-pressed=\"true\"]"
      }
    }
  ]
}
