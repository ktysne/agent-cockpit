{
  "window": {
    "width": 850,
    "height": 900
  },
  "theme": "dark",
  "integrations": {
    "codexAgent": true,
    "crossReview": true
  },
  "title": "前回見てから",
  "scenario": "basic",
  "storage": {
    "agent-cockpit.display": {
      "mode": "product"
    }
  },
  "steps": [
    {
      "do": "click",
      "selector": "#away-toggle"
    },
    {
      "do": "wait",
      "selector": ".news"
    },
    {
      "do": "screenshot",
      "name": "box",
      "target": ".news",
      "parts": {
        "since.head": ".news .news-head",
        "since.seen": ".news [data-seen]",
        "since.items": ".news ul"
      }
    }
  ]
}
