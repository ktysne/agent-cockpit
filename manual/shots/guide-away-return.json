{
  "window": {
    "width": 850,
    "height": 900
  },
  "theme": "dark",
  "integrations": {
    "codexAgent": true,
    "crossReview": true
  },
  "title": "戻ったら離席中のまま既読にする前と後の画面",
  "scenario": "basic",
  "storage": {
    "agent-cockpit.display": {
      "mode": "product"
    }
  },
  "steps": [
    {
      "do": "click",
      "selector": "#away-toggle"
    },
    {
      "do": "wait",
      "selector": "#root > section.section:nth-child(1) .news"
    },
    {
      "do": "screenshot",
      "name": "unseen",
      "target": [
        "#root > section.section:nth-child(1) > .head",
        "#root > section.section:nth-child(1) .decision-card"
      ]
    },
    {
      "do": "click",
      "selector": ".news [data-seen]"
    },
    {
      "do": "wait",
      "selector": "#root > section.section:nth-child(1) .news",
      "gone": true
    },
    {
      "do": "screenshot",
      "name": "seen",
      "target": [
        "#root > section.section:nth-child(1) > .head",
        "#root > section.section:nth-child(1) .decision-card"
      ]
    }
  ]
}
