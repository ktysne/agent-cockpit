{
  "name": "list",
  "target": [
    ".session-body > h3.sub:has(+ ul.task-list)",
    ".session-body > ul.task-list + .ended-toggle + .ended-toggle"
  ],
  "width": 1524,
  "height": 324,
  "parts": [
    {
      "key": "task.heading",
      "bounds": {
        "x": 0,
        "y": 2,
        "width": 1524,
        "height": 42
      },
      "visible": true
    },
    {
      "key": "task.state",
      "bounds": {
        "x": 20,
        "y": 69,
        "width": 98,
        "height": 44
      },
      "visible": true
    },
    {
      "key": "task.title",
      "bounds": {
        "x": 134,
        "y": 67,
        "width": 323,
        "height": 45
      },
      "visible": true
    },
    {
      "key": "task.count",
      "bounds": {
        "x": 1363,
        "y": 98,
        "width": 138,
        "height": 38
      },
      "visible": true
    },
    {
      "key": "task.close",
      "bounds": {
        "x": 1372,
        "y": 141,
        "width": 120,
        "height": 64
      },
      "visible": true
    },
    {
      "key": "task.criteria",
      "bounds": {
        "x": 20,
        "y": 121,
        "width": 1294,
        "height": 115
      },
      "visible": true
    },
    {
      "key": "task.todo-toggle",
      "bounds": {
        "x": 0,
        "y": 260,
        "width": 321,
        "height": 64
      },
      "visible": true
    },
    {
      "key": "task.done-toggle",
      "bounds": {
        "x": 321,
        "y": 260,
        "width": 313,
        "height": 64
      },
      "visible": true
    }
  ]
}
