{
  "name": "agent-cockpit",
  "version": "1.5.1",
  "private": true,
  "description": "Claude Code と Codex(CLI、デスクトップ)のセッションの状態(タスク、完了条件、作業中の内容、サブエージェント、判断待ち、PR)を 1 画面にまとめるローカルのダッシュボード。",
  "scripts": {
    "start": "node src/server/server.js",
    "test": "node --require ./test/support/verify-entries.js --test \"test/**/*.test.js\"",
    "test:inprocess": "node --require ./test/support/verify-entries.js --test --test-isolation=none \"test/**/*.test.js\"",
    "manual:build": "node tools/manual/build.js",
    "manual:capture": "node tools/manual/capture.js",
    "site:capture": "node tools/manual/capture.js --root site",
    "site:deploy": "node --use-system-ca tools/site-deploy.js upload",
    "site:deploy:dry": "node --use-system-ca tools/site-deploy.js upload --dry-run",
    "manual:demo": "node tools/manual/demo-server.js",
    "lint:manual": "node tools/manual/lint.js",
    "review:codex": "node tools/cross-review.js codex",
    "review:codex:fix": "node tools/cross-review.js codex --fix",
    "review:claude": "node tools/cross-review.js claude",
    "sync:cross-review": "node tools/cross-review.sync.js",
    "sync:cross-review:check": "node tools/cross-review.sync.js --check"
  },
  "devDependencies": {
    "basic-ftp": "^6.2.3"
  }
}
