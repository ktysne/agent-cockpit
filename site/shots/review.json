{
  "title": "配布ページ: 判断事項と PR のスタック",
  "scenario": "site-review",
  "window": {
    "width": 820,
    "height": 900
  },
  "scale": 1,
  "theme": "dark",
  "integrations": {
    "codexAgent": true,
    "crossReview": true
  },
  "steps": [
    {
      "do": "click",
      "selector": "[data-action=\"mode\"][data-mode=\"kind\"]"
    },
    {
      "do": "wait",
      "selector": "[data-action=\"mode\"][data-mode=\"kind\"][aria-pressed=\"true\"]"
    },
    {
      "do": "screenshot",
      "name": "review"
    }
  ]
}
